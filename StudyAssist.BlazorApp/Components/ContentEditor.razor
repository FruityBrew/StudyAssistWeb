@page "/"
@using StudyAssist.BlazorApp.ViewModels
@rendermode InteractiveServer
@using Radzen.Blazor;


<RadzenRow class="rz-text-align-left" >
    <RadzenColumn class=" rz-background-color-info-lighter rz-p-6 " Size="3">
        <RadzenRow>
            <input/>
        </RadzenRow>
        <RadzenRow class="rz-background-color-warning-lighter">
            <RadzenTree Data=@_catalogs Style="float:left">
                    <RadzenTreeLevel TextProperty="@nameof(CatalogVm.Name)" ChildrenProperty="Themes"></RadzenTreeLevel>
                    <RadzenTreeLevel TextProperty="@nameof(ThemeVm.Name)" ChildrenProperty="Issues"></RadzenTreeLevel>
                    <RadzenTreeLevel TextProperty="@nameof(IssueVm.Name)" HasChildren=@(ch => false)></RadzenTreeLevel>
            </RadzenTree>
        </RadzenRow>
    </RadzenColumn>
    <RadzenColumn class="rz-p-6 rz-background-color-success-lighter">
        <RadzenRow AlignItems="AlignItems.Normal" class="rz-background-color-danger-lighter">
            <RadzenCard Variant="Variant.Filled" class="rz-my-2 rz-mx-2 " Style="max-width: 420px">
                <RadzenStack >
                    <RadzenText>Количество повторений: 0</RadzenText>
                    <RadzenText>Дата повтора: 0</RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenRow>
        <RadzenRow>
            <RadzenHtmlEditor @bind-Value=@_htmlValue />
        </RadzenRow>
    </RadzenColumn>
</RadzenRow>

@code {
    private string _htmlValue = string.Empty;
    private List<CatalogVm> _catalogs;
    protected override async Task OnInitializedAsync()
    {
        _catalogs = await AppDtoReseiver.GetCatalogsAsync();
        _htmlValue = await AppDtoReseiver.GetIssue(1);
    }
}
