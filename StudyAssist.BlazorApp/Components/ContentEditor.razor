@page "/"
@using StudyAssist.BlazorApp.ViewModels
@rendermode InteractiveServer
@using Radzen.Blazor;
@using Utilities


<RadzenRow class=" rz-text-align-left" >
    <RadzenColumn Size="3" Gap="0rem" class="rz-py-2">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0rem">

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0rem"  >
                <RadzenTextBox Placeholder="Search..." Name="Search" Style="width:100%"/>
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Icon="close"></RadzenButton>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Vertical" class="rz-my-5">
                <RadzenLabel  Text="Каталог:" class="rz-my-2 rz-mx-2"/>
                <RadzenTree Data=@_catalogs Change="@CurrentItemChanged" @bind-Value=@_currentItem Style="float:left">
                    <RadzenTreeLevel 
                        TextProperty="@nameof(CatalogVm.Name)" 
                        Expanded=@(value => _ExpandCatalog(value)) 
                        ChildrenProperty="Themes">
                    </RadzenTreeLevel>
                    <RadzenTreeLevel 
                        TextProperty="@nameof(ThemeVm.Name)" 
                        Expanded=@(value => _ExpandTheme(value))
                        ChildrenProperty="Issues">
                    </RadzenTreeLevel>
                    <RadzenTreeLevel 
                        TextProperty="@nameof(ItemVm.Name)"  
                        HasChildren=@(ch => false )>
                    </RadzenTreeLevel>
                </RadzenTree>
                <RadzenButton Text="create new catalog" 
                              Icon="add"
                              Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Success"
                              Click=@(arg => _CreateNewCatalog())
                              Size="ButtonSize.Small"
                              @bind-Visible=@_IsNotStudy
                              Style="width:max-content"
                              class="rz-text-align-left rz-my-2">

                </RadzenButton>
            </RadzenStack>
        </RadzenStack>
    </RadzenColumn>
    <RadzenColumn Gap="0rem" >
        <RadzenRow class="rz-my-2 ">
            <RadzenStack Orientation="Orientation.Horizontal" class="rz-w-100">
                <RadzenCard 
                    Variant="Variant.Filled"  
                    Style="width:max-content; max-width: 420px"
                    @bind-Visible=@_isIssueVisible>
                    <RadzenStack>
                        <RadzenText Text=@_repeatCountText></RadzenText>
                        <RadzenText Text=@_repeatDateText></RadzenText>
                        <RadzenButton Text="study on"
                                      Icon="list_alt_add"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Success"
                                      Click=@(arg => _AddToStudy())
                                      Size="ButtonSize.Small"
                                      @bind-Visible=@_IsNotStudy>

                        </RadzenButton>
                        <RadzenButton Text="study off"
                                      Icon="scan_delete"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.Small"
                                      Click=@(arg => _RemoveFromStudy())
                                      @bind-Visible=@_editingIssue.IsStudy>

                        </RadzenButton>
                    </RadzenStack>
                </RadzenCard>

                <RadzenFormField 
                    Text="Наименование каталога" 
                    Variant="Variant.Text" 
                    @bind-Visible=@_isCatalogVisible class="rz-w-25 rz-my-10">
                        <RadzenTextBox 
                            @bind-Value="@_selectedCatalog.Name"
                            Change=@(args => _CatalogNameOnChange(args))>
                        </RadzenTextBox>
                </RadzenFormField>
                <RadzenFormField 
                    Text="Наименование темы" 
                    Variant="Variant.Text" 
                    @bind-Visible=@_isThemeVisible 
                    class="rz-w-25 rz-my-10">
                        <RadzenTextBox 
                            @bind-Value="@_selectedTheme.Name"  
                            Change=@(args=> _ThemeNameOnChange(args)) />
                        </RadzenFormField>
                <RadzenFormField 
                    Text="Наименование заметки" 
                    Variant="Variant.Text" 
                    @bind-Visible=@_isIssueVisible 
                    class="rz-w-100 rz-my-10">
                    <RadzenTextBox 
                        @bind-Value="@_selectedItem.Name"
                        Change=@(args => _IssueNameOnChange(args)) />
                </RadzenFormField>
                <RadzenButton 
                        Text="Create new theme" 
                        Icon="add" 
                        Variant="Variant.Text" 
                        ButtonStyle="ButtonStyle.Primary" 
                        Size="ButtonSize.Small"
                        Click=@(arg => _CreateNewTheme())
                            class="rz-my-10"
                        @bind-Visible=@_isCatalogVisible >

                </RadzenButton>
                <RadzenButton   Text="Create new issue" 
                                Icon="add" 
                                Variant="Variant.Text" 
                                ButtonStyle="ButtonStyle.Primary" 
                                Size="ButtonSize.Small"
                                Click=@(arg => _CreateNewIssue())
                                    class="rz-my-10"
                                @bind-Visible=@_isThemeVisible >

                </RadzenButton>
                <RadzenButton Text="Delete catalog"
                              Icon="delete"
                              Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Danger"
                              Size="ButtonSize.Small"
                              Click=@(arg => _DeleteCatalog())
                              class="rz-my-10"
                              @bind-Visible=@_isCatalogVisible>

                </RadzenButton>
                <RadzenButton Text="Delete theme"
                              Icon="delete"
                              Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Danger"
                              Size="ButtonSize.Small"
                              Click=@(arg => _DeleteTheme())
                              class="rz-my-10"
                              @bind-Visible=@_isThemeVisible>

                </RadzenButton>
                <RadzenButton Text="Delete issue"
                              Icon="delete"
                              Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Danger"
                              Size="ButtonSize.Small"
                              Click=@(arg => _DeleteIssue())
                              class="rz-my-10"
                              @bind-Visible=@_isIssueVisible>

                </RadzenButton>
            </RadzenStack>
        </RadzenRow>
        <RadzenRow>
            <RadzenHtmlEditor @bind-Visible=@_isIssueVisible
                              @bind-Value=@_editingIssue.AnswerText 
                              @oninput=@(changeEventArg => _AnswerChanged(changeEventArg))
                class="rz-w-100" />
        </RadzenRow>
    </RadzenColumn>
</RadzenRow>

@code {
    // private string _htmlValue = string.Empty;
    private List<CatalogVm> _catalogs;
    private EditingIssueVm _editingIssue;
    private EditingIssueVm _defaultIssue;
    private ThemeVm _defaultTheme;
    private CatalogVm _defaultCatalog;
    private ItemVm _defaultItem;
    private object _currentItem;
    private string _repeatCountText = @"Количество повторений: -";
    private string _repeatDateText = @"Дата повтора: -";
    private CatalogVm _selectedCatalog;
    private ThemeVm _selectedTheme;
    private ItemVm _selectedItem;

    private bool f = true;

    private bool _isThemeVisible = false;
    private bool _isIssueVisible = false;
    private bool _isCatalogVisible = false;

    private bool _isCatalogDisabled = true;
    private bool _isThemeDisabled = false;
    private bool _isIssueDisabled = false;

    private string _expandedCatalog;
    private string _expandedTheme;

    private TypingTimer _timer;

    private bool _IsNotStudy
    {
        get
        {
            return !_editingIssue.IsStudy;
        }
        set
        {

        }
    }

    protected override async Task OnInitializedAsync()
    {
        _catalogs = await AppDtoReseiver.GetCatalogsAsync();
        _defaultCatalog = new CatalogVm();
        _defaultTheme = new ThemeVm();
        _defaultItem = new ItemVm();
        _editingIssue = new EditingIssueVm();
        _defaultIssue = new EditingIssueVm
            {
                AnswerText = string.Empty,
                IsStudy = false,
                RepeatDate = null
            };

        _selectedCatalog = new CatalogVm();
        _selectedTheme = new ThemeVm();
        _selectedItem = new ItemVm();

        _timer = new(3);
    }

    internal bool Getf()
    {
        return _selectedItem == null;
    }

    internal async void CurrentItemChanged()
    {
        if (_currentItem is CatalogVm catalog)
        {
            _selectedCatalog = _catalogs
                .FirstOrDefault(cat => cat.Id == catalog.Id)!;
            // _isCatalogSelected = true;
            _selectedTheme = _defaultTheme;
            _selectedItem = _defaultItem;

            _isThemeVisible = false;
            _isIssueVisible = false;
            _isCatalogVisible = true;
            // _isCatalogDisabled = false;
            _editingIssue = _defaultIssue;

            // _repeatCountText = @"Количество повторений: -";
            // _repeatDateText = @"Дата повтора: -";

        }
        else if( _currentItem is ThemeVm theme)
        {
            _selectedCatalog = _catalogs
                .FirstOrDefault(cat => cat.Id == theme.ParentId)!;
            _selectedTheme = _selectedCatalog.Themes
                .FirstOrDefault(th => th.Id == theme.Id)!;

            _selectedItem = _defaultItem;
            _isThemeVisible = true;
            _isIssueVisible = false;
            _isCatalogVisible = false;
            // _isCatalogDisabled = true;
            // _isThemeDisabled = false;
            _editingIssue = _defaultIssue;

            // _repeatCountText = @"Количество повторений: -";
            // _repeatDateText = @"Дата повтора: -";

            return;
        }
        else if(_currentItem is ItemVm issueItem)
        {
            _selectedItem = issueItem;
            _selectedTheme = _FindThemeBy(issueItem.ParentId)!;
            _selectedCatalog = _catalogs
                .FirstOrDefault(cat => cat.Id == _selectedTheme.ParentId)!;


            var res = await AppDtoReseiver.GetEditingIssue(issueItem.Id);


            if (res == null)
            {
                _editingIssue = _defaultIssue;
                _repeatCountText = @"Количество повторений: -";
                _repeatDateText = @"Дата повтора: -";
            }
            else
            {
                if (res.AnswerText == null)
                    res.AnswerText = string.Empty;                    

                _editingIssue = res;
                _repeatCountText = @"Количество повторений: " + _editingIssue.RepeatCount;
                _repeatDateText = @"Дата повтора: " + 
                    (_editingIssue.RepeatDate.HasValue 
                        ? _editingIssue.RepeatDate.Value.ToString("dd.MM.yyyy")
                        : string.Empty);
            }

            _isIssueVisible = true;
            _isCatalogVisible = false;
            _isThemeVisible = false;
        }
    }

    private ThemeVm? _FindThemeBy(int themeId)
    {
        return _catalogs
            .SelectMany(cat => cat.Themes)
            .FirstOrDefault(th => th.Id == themeId);
    }

    private ItemVm? _FindIssueBy(int issueId)
    {
        return _catalogs
            .SelectMany(cat => cat.Themes)
            .SelectMany(t => t.Issues)
            .FirstOrDefault(th => th.Id == issueId);
    }

    private async void _CreateNewTheme()
    {
        // _selectedTheme = new ThemeVm();

        ThemeVm newTheme = new ThemeVm
            {
                ParentId = _selectedCatalog.Id,
                Name = "Введите наименование темы...",
            };

        int newThemeId = await AppDtoReseiver.AddThemeAsync(newTheme);

        _catalogs = await AppDtoReseiver.GetCatalogsAsync();

        _expandedCatalog = _selectedCatalog.Name;

        _currentItem = _FindThemeBy(newThemeId)!;

        CurrentItemChanged();
    }

    private bool _ExpandCatalog(object value)
    {
        return (value as CatalogVm)?.Name == _expandedCatalog;
    }

    private bool _ExpandTheme(object value)
    {
        return (value as ThemeVm)?.Name == _expandedTheme;
    }

    private async void _ThemeNameOnChange(string args)
    {
        await AppDtoReseiver.UpdateThemeNameAsync(_selectedTheme);
        // _catalogs = await AppDtoReseiver.GetCatalogsAsync();
    }
    private async void _CatalogNameOnChange(string args)
    {
        await AppDtoReseiver.UpdateCatalogNameAsync(_selectedCatalog);
    }
    private async void _IssueNameOnChange(string args)
    {
        await AppDtoReseiver.UpdateIssueNameAsync(_selectedItem);
    }


    private async void _AnswerChanged(ChangeEventArgs args)
    {
        if(_timer.IsActive == false)
            _timer.Activate(async () =>
            {
                await AppDtoReseiver.UpdateIssueAnswerAsync(_editingIssue);
            });

    }

    private async void _CreateNewIssue()
    {
        EditingIssueVm newIssue = new EditingIssueVm
            {
                ParentId = _selectedTheme.Id,
                Name = "Введите наименование вопроса..."
            };

        int newIssueId = await AppDtoReseiver.AddIssueAsync(newIssue);

        _catalogs = await AppDtoReseiver.GetCatalogsAsync();

        _expandedCatalog = _catalogs.FirstOrDefault(cat => cat.Id == _selectedTheme.ParentId).Name;
        _expandedTheme = _selectedTheme.Name;

        _currentItem = _FindIssueBy(newIssueId);

        CurrentItemChanged();
    }

    private async void _DeleteCatalog()
    {
        await AppDtoReseiver.DeleteCatalogAsync(_selectedCatalog);
        _catalogs = await AppDtoReseiver.GetCatalogsAsync();
        _selectedCatalog = null;
    }

    private async void _DeleteTheme()
    {
        await AppDtoReseiver.DeleteThemeAsync(_selectedTheme);
        _catalogs = await AppDtoReseiver.GetCatalogsAsync();
        _selectedTheme = _defaultTheme;
    }

    private async void _DeleteIssue()
    {
        await AppDtoReseiver.DeleteIssueAsync(_selectedItem);
        _catalogs = await AppDtoReseiver.GetCatalogsAsync();

        ThemeVm selectedTheme = _FindThemeBy(_selectedItem.ParentId);

        _selectedItem = _defaultItem;
        _editingIssue = _defaultIssue;

        _selectedTheme = selectedTheme;
        _currentItem = selectedTheme;
        CurrentItemChanged();
        _expandedCatalog = _catalogs.FirstOrDefault(f => f.Id == _selectedTheme.Id).Name;

        _expandedTheme = _selectedTheme.Name;
    }

    private async void _AddToStudy()
    {
        _editingIssue.IsStudy = true;
        await AppDtoReseiver.UpdateIssueStudyAsync(_editingIssue);
        CurrentItemChanged();
    }

    private async void _RemoveFromStudy()
    {
        _editingIssue.IsStudy = false;
        await AppDtoReseiver.UpdateIssueStudyAsync(_editingIssue);
        CurrentItemChanged();

    }

    private async void _CreateNewCatalog()
    {
        CatalogVm catalog = new CatalogVm
        {
            Name = "Введите название каталога..."
        };
        // newTheme = new ThemeVm
        //    {
        //        ParentId = _selectedCatalog.Id,
        //        Name = "Введите наименование темы...",
        //    };


        int newCatId = await AppDtoReseiver.AddCatalogAsync(catalog);
        _catalogs = await AppDtoReseiver.GetCatalogsAsync();
        _currentItem = _catalogs.FirstOrDefault(cat => cat.Id == newCatId);
        CurrentItemChanged();
    }
}
