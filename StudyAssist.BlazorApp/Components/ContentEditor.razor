@page "/"
@using StudyAssist.BlazorApp.ViewModels
@rendermode InteractiveServer
@using Radzen.Blazor;


<RadzenRow class=" rz-text-align-left" >
    <RadzenColumn Size="3" Gap="0rem" class="rz-py-2">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0rem">

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0rem"  >
                <RadzenTextBox Placeholder="Search..." Name="Search" Style="width:100%"/>
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Icon="close"></RadzenButton>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Vertical" class="rz-my-5">
                <RadzenLabel  Text="Каталог:" class="rz-my-2 rz-mx-2"/>
                <RadzenTree Data=@_catalogs Change="@CurrentItemChanged"  @bind-Value=@_currentItem Style="float:left">
                    <RadzenTreeLevel TextProperty="@nameof(CatalogVm.Name)"  ChildrenProperty="Themes"></RadzenTreeLevel>
                    <RadzenTreeLevel TextProperty="@nameof(ThemeVm.Name)" ChildrenProperty="Issues"></RadzenTreeLevel>
                    <RadzenTreeLevel TextProperty="@nameof(ItemVm.Name)"  HasChildren=@(ch => false )></RadzenTreeLevel>
                </RadzenTree>
            </RadzenStack>
            
        </RadzenStack>
    </RadzenColumn>
    <RadzenColumn Gap="0rem">
        <RadzenRow AlignItems="AlignItems.Normal" >
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenCard Variant="Variant.Filled" class="rz-my-2 " Style="max-width: 420px">
                    <RadzenStack>
                        <RadzenText Text=@_repeatCountText></RadzenText>
                        <RadzenText Text=@_repeatDateText></RadzenText>
                    </RadzenStack>
                </RadzenCard>
                <RadzenFormField Text="Наименование каталога" Variant="Variant.Text" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="@_selectedCatalog.Name"/>
                </RadzenFormField>
                <RadzenFormField Text="Наименование темы" Variant="Variant.Text" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="@_selectedTheme.Name" />
                </RadzenFormField>
                <RadzenFormField Text="Наименование заметки" Variant="Variant.Text" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="@_selectedItem.Name" @bind-Disabled=@f/>
                </RadzenFormField>
            </RadzenStack>
        </RadzenRow>
        <RadzenRow>
            <RadzenHtmlEditor @bind-Value=@_editingIssue.AnswerText />
        </RadzenRow>
    </RadzenColumn>
</RadzenRow>

@code {
    // private string _htmlValue = string.Empty;
    private List<CatalogVm> _catalogs;
    private EditingIssueVm _editingIssue;
    private EditingIssueVm _defaultIssue;
    private object _currentItem;
    private string _repeatCountText = @"Количество повторений: -";
    private string _repeatDateText = @"Дата повтора: -";
    private CatalogVm _selectedCatalog;
    private ThemeVm _selectedTheme;
    private ItemVm _selectedItem;

    private bool f = true;

    protected override async Task OnInitializedAsync()
    {
        _catalogs = await AppDtoReseiver.GetCatalogsAsync();
        _editingIssue = new EditingIssueVm();
        _defaultIssue = new EditingIssueVm
            {
                AnswerText = string.Empty,
                IsStudy = false,
                RepeatDate = null
            };

        _selectedCatalog = new CatalogVm();
        _selectedTheme = new ThemeVm();
        _selectedItem = new ItemVm();

    }

    internal bool Getf()
    {
        return _selectedItem == null;
    }

    internal async void CurrentItemChanged()
    {
        if (_currentItem is CatalogVm catalog)
        {
            _selectedCatalog = _catalogs
                .FirstOrDefault(cat => cat.Id == catalog.Id)!;
            // todo заменить!!
            _selectedTheme = new ThemeVm();
            _selectedItem = new ItemVm();
        }
        else if( _currentItem is ThemeVm theme)
        {
            _selectedCatalog = _catalogs
                .FirstOrDefault(cat => cat.Id == theme.ParentId)!;
            _selectedTheme = _selectedCatalog.Themes
                .FirstOrDefault(th => th.Id == theme.Id)!;

            // todo заменить!!
            _selectedItem = new ItemVm();

            return;
        }
        else if(_currentItem is ItemVm issueItem)
        {
            _selectedItem = issueItem;
            _selectedTheme = _FindThemeBy(issueItem.ParentId)!;
            _selectedCatalog = _catalogs
                .FirstOrDefault(cat => cat.Id == _selectedTheme.ParentId)!;


            var res = await AppDtoReseiver.GetEditingIssue(issueItem.Id);


            if (res == null)
            {
                _editingIssue = _defaultIssue;
                _repeatCountText = @"Количество повторений: -";
                _repeatDateText = @"Дата повтора: -";
            }
            else
            {
                _editingIssue = res;
                _repeatCountText = @"Количество повторений: " + _editingIssue.RepeatCount;
                _repeatDateText = @"Дата повтора: " + 
                    (_editingIssue.RepeatDate.HasValue 
                        ? _editingIssue.RepeatDate.Value.ToString("dd.MM.yyyy")
                        : "-");
            }
        }
    }

    private ThemeVm? _FindThemeBy(int themeId)
    {
        return _catalogs
            .SelectMany(cat => cat.Themes)
            .FirstOrDefault(th => th.Id == themeId);
    }
}
