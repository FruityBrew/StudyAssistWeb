@page "/"
@using StudyAssist.BlazorApp.ViewModels
@rendermode InteractiveServer
@using Radzen.Blazor;
@using Utilities


<RadzenRow class=" rz-text-align-left" >
    <RadzenColumn Size="3" Gap="0rem" class="rz-py-2">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0rem">

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0rem"  >
                <RadzenTextBox Placeholder="Search..." Name="Search" Style="width:100%"/>
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Icon="close"></RadzenButton>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Vertical" class="rz-my-5">
                <RadzenLabel  Text="Каталог:" class="rz-my-2 rz-mx-2"/>
                <RadzenTree Data=@_mainVm._catalogs Change="@_mainVm.CurrentItemChanged" @bind-Value=@_mainVm._currentItem Style="float:left">
                    <RadzenTreeLevel 
                        TextProperty="@nameof(CatalogVm.Name)"
                                     Expanded=@(value => _mainVm._ExpandCatalog(value))
                                     ChildrenProperty="Themes">
                    </RadzenTreeLevel>
                    <RadzenTreeLevel 
                        TextProperty="@nameof(ThemeVm.Name)"
                                     Expanded=@(value => _mainVm._ExpandTheme(value))
                        ChildrenProperty="Issues">
                    </RadzenTreeLevel>
                    <RadzenTreeLevel 
                        TextProperty="@nameof(ItemVm.Name)"  
                        HasChildren=@(ch => false )>
                    </RadzenTreeLevel>
                </RadzenTree>
                <RadzenButton Text="create new catalog" 
                              Icon="add"
                              Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Success"
                              Click=@(arg => _mainVm._CreateNewCatalog())
                              Size="ButtonSize.Small"
                              Style="width:max-content"
                              class="rz-text-align-left rz-my-2">

                </RadzenButton>
            </RadzenStack>
        </RadzenStack>
    </RadzenColumn>
    <RadzenColumn Gap="0rem" >
        <RadzenRow class="rz-my-2 ">
            <RadzenStack Orientation="Orientation.Horizontal" class="rz-w-100">
                <RadzenCard 
                    Variant="Variant.Filled"  
                    Style="width:max-content; max-width: 420px"
                            @bind-Visible=@_mainVm._isIssueVisible>
                    <RadzenStack>
                        <RadzenText Text=@_mainVm._repeatCountText></RadzenText>
                        <RadzenText Text=@_mainVm._repeatDateText></RadzenText>
                        <RadzenButton Text="study on"
                                      Icon="list_alt_add"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Success"
                                      Click=@(arg => _mainVm._AddToStudy())
                                      Size="ButtonSize.Small"
                                      @bind-Visible=@_mainVm._IsNotStudy>

                        </RadzenButton>
                        <RadzenButton Text="study off"
                                      Icon="scan_delete"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.Small"
                                      Click=@(arg => _mainVm._RemoveFromStudy())
                                      @bind-Visible=@_mainVm._editingIssue.IsStudy>

                        </RadzenButton>
                    </RadzenStack>
                </RadzenCard>

                <RadzenFormField 
                    Text="Наименование каталога" 
                    Variant="Variant.Text"
                                 @bind-Visible=@_mainVm._isCatalogVisible class="rz-w-25 rz-my-10">
                        <RadzenTextBox @bind-Value="@_mainVm._selectedCatalog.Name"
                                   Change=@(args => _mainVm._CatalogNameOnChange(args))
                            onfocus="this.select()">
                        </RadzenTextBox>
                </RadzenFormField>
                <RadzenFormField 
                    Text="Наименование темы" 
                    Variant="Variant.Text"
                                 @bind-Visible=@_mainVm._isThemeVisible
                                 class="rz-w-25 rz-my-10">
                        <RadzenTextBox @bind-Value="@_mainVm._selectedTheme.Name"
                                   Change=@(args=> _mainVm._ThemeNameOnChange(args))
                            onfocus="this.select()" />
                        </RadzenFormField>
                <RadzenFormField 
                    Text="Наименование заметки" 
                    Variant="Variant.Text"
                                 @bind-Visible=@_mainVm._isIssueVisible
                                 class="rz-w-100 rz-my-10">
                    <RadzenTextBox @bind-Value="@_mainVm._selectedItem.Name"
                                   Change=@(args => _mainVm._IssueNameOnChange(args))
                                   onfocus="this.select()"/>
                </RadzenFormField>
                <RadzenButton 
                        Text="Create new theme" 
                        Icon="add" 
                        Variant="Variant.Text" 
                        ButtonStyle="ButtonStyle.Primary" 
                        Size="ButtonSize.Small"
                              Click=@(arg => _mainVm._CreateNewTheme())
                            class="rz-my-10"
                              @bind-Visible=@_mainVm._isCatalogVisible>

                </RadzenButton>
                <RadzenButton   Text="Create new issue" 
                                Icon="add" 
                                Variant="Variant.Text" 
                                ButtonStyle="ButtonStyle.Primary" 
                                Size="ButtonSize.Small"
                              Click=@(arg => _mainVm._CreateNewIssue())
                                    class="rz-my-10"
                              @bind-Visible=@_mainVm._isThemeVisible>

                </RadzenButton>
                <RadzenButton Text="Delete catalog"
                              Icon="delete"
                              Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Danger"
                              Size="ButtonSize.Small"
                              Click=@(arg => _mainVm._DeleteCatalog())
                              class="rz-my-10"
                              @bind-Visible=@_mainVm._isCatalogVisible>

                </RadzenButton>
                <RadzenButton Text="Delete theme"
                              Icon="delete"
                              Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Danger"
                              Size="ButtonSize.Small"
                              Click=@(arg =>_mainVm._DeleteTheme())
                              class="rz-my-10"
                              @bind-Visible=@_mainVm._isThemeVisible>

                </RadzenButton>
                <RadzenButton Text="Delete issue"
                              Icon="delete"
                              Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Danger"
                              Size="ButtonSize.Small"
                              Click=@(arg => _mainVm._DeleteIssue())
                              class="rz-my-10"
                              @bind-Visible=@_mainVm._isIssueVisible>

                </RadzenButton>
            </RadzenStack>
        </RadzenRow>
        <RadzenRow>
            <RadzenHtmlEditor @bind-Visible=@_mainVm._isIssueVisible
                              @bind-Value=@_mainVm._editingIssue.AnswerText
                              @oninput=@(changeEventArg => _mainVm._AnswerChanged(changeEventArg))
                class="rz-w-100" />
        </RadzenRow>
    </RadzenColumn>
</RadzenRow>

@code {
    private MainViewModel _mainVm;

    protected override async Task OnInitializedAsync()
    {
        _mainVm = await MainViewModel.CreateAsync();
    }
}
