@page "/counter"
@rendermode InteractiveServer

<p>Count: @currentCount</p>
<button @onclick="Inc">+</button>
<button @onclick="Decr">-</button>

@code {
    private int currentCount;

    private void Inc()
    {
        currentCount++;
    }

    private void Decr()
    {
        currentCount--;
    }
}
