@page "/repeat"
@using StudyAssist.BlazorApp.ViewModels
@using Radzen.Blazor;

@rendermode InteractiveServer


<RadzenRow class="rz-p-0 rz-p-lg-12">
    <RadzenColumn Size="12" SizeLG="4">
        <RadzenCard>
            <RadzenTree Data=@_mainVm.Catalogs>
                <RadzenTreeLevel TextProperty="@nameof(CatalogVm.Name)" ChildrenProperty="Themes"></RadzenTreeLevel>
                <RadzenTreeLevel TextProperty="@nameof(ThemeVm.Name)" ChildrenProperty="Issues"></RadzenTreeLevel>
                <RadzenTreeLevel TextProperty="@nameof(ItemVm.Name)" HasChildren=@(ch => false)></RadzenTreeLevel>



            </RadzenTree>
        </RadzenCard>
    </RadzenColumn>

</RadzenRow>


@code {
    private MainViewModel _mainVm;

    protected override async Task OnInitializedAsync()
    {
        _mainVm = await MainViewModel.CreateRepeatCatalogAsync();
    }
}
